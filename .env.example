# Wedding Booking Core — blank production template
# Use per-studio hosting secrets or .env.production.local. Do not commit filled values.
# NODE_ENV is supplied by Next.js: next dev=development, next build/start=production.
# Direct test runners use NODE_ENV=test. Never use NODE_ENV=demo or staging.
# NODE_ENV=production

# Explicit backend choice. Production permits gas only; no automatic mock fallback.
BACKEND_MODE=gas

# Independent random server-only values, each >=32 characters (recommend 32 random bytes).
APP_SECRET=
GAS_SHARED_SECRET=

# Public application origin; Production requires HTTPS, no path/query/credentials.
APP_URL=
# Dedicated GAS Web App /exec deployment URL. No /dev URLs.
GAS_WEBAPP_URL=

# Operational recipient. Production never falls back to studioConfig or Demo fixtures.
REPRESENTATIVE_EMAIL=

# Legacy migration only; do not set these alongside different canonical values.
# APP_URL alias: NEXT_PUBLIC_APP_URL
# REPRESENTATIVE_EMAIL alias: STUDIO_REP_EMAIL
# Dear Memory Client only: DEAR_MEMORY_REP_EMAIL (never copied into a new studio)
# New studios use APP_URL and REPRESENTATIVE_EMAIL above.

# GAS Script Properties (set in the GAS project, not this app env file):
# GAS_SHARED_SECRET = same value as the app server
# CONTRACTS_FOLDER_ID = private dedicated Drive folder ID
# Discount codes require the administrator module below and its private settings revision.
# No spreadsheet ID or sheet name is used for discount-code validation.

# Local Demo only: place BACKEND_MODE=demo in .env.development.local or .env.test.local.
# Demo needs development/test NODE_ENV, never contacts real GAS/Gmail/Drive.
# Demo APP_URL may be a local HTTP origin; if omitted, localhost:3000 is used.
# Omitted Demo APP_SECRET is generated per process; restart invalidates Demo review tokens.

# Administrator settings module: explicit activation after deploying the updated GAS.
# Keep false until a SEPARATE private settings folder and password hash are configured.
STUDIO_SETTINGS_ENABLED=false
# Server only. Format: scrypt$16384$8$1$<16-byte hex salt>$<64-byte hex derived key>.
# Generate from stdin with scripts/create-admin-password-hash.cjs (see docs/STUDIO_ADMINISTRATION.md).
# In dotenv files wrap the hash in single quotes; never use NEXT_PUBLIC_ or a plaintext password.
# Owner mobile login: exactly six digits, hashed with --owner-pin; legacy long Owner passwords remain valid only on the existing settings login.
# Master: independent password of at least 12 characters. Never use the Owner PIN for Master.
STUDIO_OWNER_PASSWORD_HASH=
# Optional migration/bootstrap hash. Master Console can save a per-studio PIN independently.
# Missing both stored PIN and env hash: initial 000000 works only in explicit local Demo.
# Production requires a configured Owner credential before private data access.
MASTER_ADMIN_PASSWORD_HASH=
# Legacy migration only: when MASTER_ADMIN_PASSWORD_HASH is absent, this remains Master.
# It NEVER becomes an Owner credential. Keep until new Master login is verified.
STUDIO_ADMIN_PASSWORD_HASH=
# Additional GAS Script Property (not an application environment value):
# STUDIO_SETTINGS_FOLDER_ID = separate private Drive folder, different from CONTRACTS_FOLDER_ID.
# Optional contract-list Sheets is OFF by default and enabled in the authenticated admin UI.
# No Spreadsheet ID or Sheets URL environment variable is required; GAS stores the private link.
